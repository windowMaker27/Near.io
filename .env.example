# Google Places (optionnel — OSM fonctionne sans)
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# Overpass API
EXPO_PUBLIC_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Paramètres app
EXPO_PUBLIC_DEFAULT_RADIUS_METERS=1000
EXPO_PUBLIC_ENABLE_GOOGLE_ENRICHMENT=true

# Supabase (requis pour la soumission de lieux)
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
