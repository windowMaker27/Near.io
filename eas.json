{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_OVERPASS_URL": "https://overpass-api.de/api/interpreter",
        "EXPO_PUBLIC_DEFAULT_RADIUS_METERS": "800",
        "EXPO_PUBLIC_ENABLE_GOOGLE_ENRICHMENT": "false"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6782003223"
      }
    }
  }
}
